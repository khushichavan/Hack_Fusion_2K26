# Required: Secret key for JWT token signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=

# Optional: MongoDB connection (falls back to local JSON storage if not set)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=aquaresolve_ai

# Optional: Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Environment mode (development/production)
ENV=development
